# Copy to .env for local CLI runs:   cp .env.example .env
# .env is gitignored. NEVER commit real keys.
#
# GitHub Actions does NOT read this file — set the same names there under
#   Settings -> Secrets and variables -> Actions -> New repository secret
# A real environment variable always wins over this file.

# ── Models: you need AT LEAST ONE of the three ────────────────────────────────

# Gemini — recommended. The direct API is the only genuinely free path to a
# Flash model (OpenRouter carries Gemini but charges for every tier).
# Free tier, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — free tier, very fast. https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — free-tier models only by default. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Telegram: needed for the topic-pick checkpoint ────────────────────────────
# Without these, research still runs but cannot send you the brief, and draft
# has no reply to read.
# Bot token: message @BotFather on Telegram -> /newbot
TELEGRAM_BOT_TOKEN=
# Your chat id: message @userinfobot, or open
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates after texting your bot
TELEGRAM_CHAT_ID=

# ── Optional ─────────────────────────────────────────────────────────────────

# Dev.to — without it, drafts still save to the repo as Markdown.
# https://dev.to/settings/extensions -> DEV Community API Keys
DEVTO_API_KEY=

# Only needed for LOCAL runs that write files back to the repo. GitHub Actions
# injects this automatically — do not add it as a repository secret.
# Needs 'repo' scope: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_REPOSITORY=Giri-Suman/coderfact-engine

# ── Persona (set as Actions *Variables*, not Secrets) ─────────────────────────
AUTHOR_NAME=Suman Giri
# AUTHOR_CONTEXT=
# AUTHOR_VIBE=

# ── Tuning (all optional — see README) ────────────────────────────────────────
# GEMINI_MODELS=gemini-3.7-flash,gemini-3.5-flash
# OPENROUTER_MODELS=z-ai/glm-5.2:free,minimax/minimax-m3:free
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_ALLOW_PAID=1     # lets openrouter/auto bill you. Off by default.
